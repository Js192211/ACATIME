    <title>Panel del Estudiante | AcadTime</title>

    <link rel="stylesheet" href="estudiante.css">
</head>

<body>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="container">

        <!-- MENÚ LATERAL -->
        <aside class="sidebar">

            <div class="logo">
                <h2>AcadTime</h2>
                <p>Gestión Académica</p>
            </div>

            <nav class="menu">
                <a href="estudiante.html" class="active">🏠 Inicio</a>
