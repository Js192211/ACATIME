            <section class="content-section">

                <div class="section-header">
                    <h2>Últimas notificaciones</h2>
                    <a href="notificaciones.html">Ver todas</a>
                </div>

                <div class="notification-list">

                    <article class="notification">
                        <div class="notification-icon">🔔</div>

                        <div>
                            <h3>Actualización de horario</h3>
                            <p>
                                Revisa tu horario para conocer
                                posibles cambios de aula.
                            </p>
                            <small>Notificación académica</small>
                        </div>
                    </article>

                    <article class="notification">
                        <div class="notification-icon">📚</div>

                        <div>
                            <h3>Información académica</h3>
                            <p>
                                Consulta las actividades pendientes
                                de tus materias.
                            </p>
                            <small>Recordatorio</small>
                        </div>
                    </article>

                </div>

            </section>


            <!-- PIE DE PÁGINA -->
            <footer class="footer">
                <p>
                    © 2026 AcadTime | Sistema de Gestión de Horarios Académicos
                </p>
            </footer>

        </main>

    </div>

</body>
</html>
