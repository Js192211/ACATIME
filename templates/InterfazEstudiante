            <section class="content-section">

                <div class="section-header">
                    <h2>Próxima clase</h2>
                    <a href="horario-estudiante.html">
                        Ver horario completo
                    </a>
                </div>

                <article class="next-class">

                    <div class="class-time">
                        <span>08:00</span>
                        <small>10:00</small>
                    </div>

                    <div class="class-details">
                        <h3>Programación Orientada a Objetos</h3>
                        <p>👨‍🏫 Docente: Nombre del docente</p>
                        <p>📍 Aula: Laboratorio 1</p>
                        <p>📅 Día: Lunes</p>
                    </div>

                    <span class="status">Programada</span>

                </article>

            </section>


            <!-- HORARIO SEMANAL -->
            <section class="content-section">

                <div class="section-header">
                    <h2>Mi horario semanal</h2>
                    <a href="horario-estudiante.html">
                        Ver completo
                    </a>
                </div>

                <div class="table-container">

                    <table class="schedule-table">

                        <thead>
                            <tr>
                                <th>Hora</th>
                                <th>Lunes</th>
                                <th>Martes</th>
                                <th>Miércoles</th>
                                <th>Jueves</th>
                                <th>Viernes</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>08:00 - 10:00</td>
                                <td>Programación</td>
                                <td>Base de datos</td>
                                <td>Programación</td>
                                <td>Redes</td>
                                <td>Inglés</td>
                            </tr>

                            <tr>
                                <td>10:00 - 12:00</td>
                                <td>Base de datos</td>
                                <td>Redes</td>
                                <td>Inglés</td>
                                <td>Programación</td>
                                <td>Base de datos</td>
                            </tr>

                            <tr>
                                <td>13:00 - 15:00</td>
                                <td>Redes</td>
                                <td>Inglés</td>
                                <td>Base de datos</td>
                                <td>Inglés</td>
                                <td>Programación</td>
                            </tr>
                        </tbody>

                    </table>

                </div>

            </section>


