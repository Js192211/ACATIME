                <a href="notificaciones.html">🔔 Notificaciones</a>
                <a href="perfil-estudiante.html">👤 Mi perfil</a>
            </nav>

            <div class="sidebar-footer">
                <a href="index.html">🚪 Cerrar sesión</a>
            </div>

        </aside>


        <!-- CONTENIDO PRINCIPAL -->
        <main class="main-content">

            <!-- ENCABEZADO -->
            <header class="header">

                <div>
                    <h1>Panel del estudiante</h1>
                    <p>Consulta tu información académica y horarios.</p>
                </div>

                <div class="user-info">
                    <div class="avatar">JL</div>

                    <div>
                        <h3>Jesús López</h3>
                        <p>Estudiante</p>
                    </div>
                </div>

            </header>


            <!-- BIENVENIDA -->
            <section class="welcome">
                <h2>¡Bienvenido, Jesús!</h2>
                <p>
                    Organiza tus clases y mantente al día
                    con tus actividades académicas.
                </p>
            </section>


            <!-- TARJETAS DE RESUMEN -->
            <section class="dashboard-cards">

                <article class="card">
                    <div class="card-icon">📚</div>
                    <div>
                        <p>Materias inscritas</p>
                        <h2>6</h2>
                    </div>
                </article>

                <article class="card">
                    <div class="card-icon">📅</div>
                    <div>
                        <p>Clases de hoy</p>
                        <h2>4</h2>
                    </div>
                </article>

                <article class="card">
                    <div class="card-icon">👨‍🏫</div>
                    <div>
                        <p>Docentes</p>
                        <h2>5</h2>
                    </div>
                </article>

                <article class="card">
                    <div class="card-icon">🔔</div>
                    <div>
                        <p>Notificaciones</p>
                        <h2>2</h2>
                    </div>
                </article>

            </section>


